# Only the playable game, its source, assets and reproducible build are published.
/*
!/.gitignore
!/index.html
!/开始游戏.html
!/package.json
!/package-lock.json
!/vite.config.js
!/src/
!/public/
!/scripts/

/scripts/*
!/scripts/package-game.mjs
/public/*
!/public/scenes/
!/public/characters/
!/public/items/
!/public/fonts/

# Design, instructions, references, exported masters, tests and worktrees stay local.
*.md
node_modules/
dist/
test-results/
playwright-report/
coverage/
.worktrees/
.env
.env.*
*.pem
*.key
credentials.json
*.log
*.zip
*:Zone.Identifier
__pycache__/
.DS_Store
Thumbs.db
