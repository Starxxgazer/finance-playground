# Publish the game, source, runtime assets, build tools and selected public guides.
/*
!/.gitignore
!/index.html
!/开始游戏.html
!/package.json
!/package-lock.json
!/vite.config.js
!/src/
!/public/
!/scripts/

/scripts/*
!/scripts/package-game.mjs
!/scripts/deploy-game.py
/public/*
!/public/scenes/
!/public/characters/
!/public/items/
!/public/ui/
!/public/fonts/
!/public/videos/
!/public/audio/

# Design, instructions, references, exported masters, tests and worktrees stay local.
*.md
!/README.md
!/运行说明.md
!/DEPLOYMENT.md
node_modules/
dist/
test-results/
playwright-report/
coverage/
.worktrees/
.env
.env.*
*.pem
*.key
credentials.json
*.log
*.zip
*:Zone.Identifier
__pycache__/
.DS_Store
Thumbs.db
